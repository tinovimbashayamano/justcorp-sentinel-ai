APP_ENV=production
IMAGE_TAG=latest
FRONTEND_PORT=8080
POSTGRES_DB=justcorp_sentinel
POSTGRES_USER=justcorp_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg2://justcorp_app:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/justcorp_sentinel
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@redis:6379/0
REDIS_REQUIRED=true
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_ORIGIN=http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1
FRAUD_MODEL_PATH=/app/ml/model_artifacts/lightgbm_fraud_model.joblib
LOG_LEVEL=INFO
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
RUN_MIGRATIONS=true
VALIDATE_MODEL_ARTIFACTS=true
